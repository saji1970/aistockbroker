# Railway Deployment Environment Variables Template
# Copy this file and set the actual values in Railway dashboard

# ===  AI Provider Configuration ===
AI_PROVIDER=huggingface
HF_API_TOKEN=your_huggingface_token_here
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# === Database (Auto-set by Railway PostgreSQL service) ===
DATABASE_URL=${DATABASE_URL}

# === Flask Configuration ===
PORT=${PORT}
FLASK_ENV=production
SECRET_KEY=generate_random_secret_key_here
JWT_SECRET_KEY=generate_random_jwt_secret_here

# === Optional: Gemini (for fallback or switching between providers) ===
# GOOGLE_API_KEY=your_google_api_key_here

# === Optional: Market Data APIs ===
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=
# MARKETSTACK_API_KEY=

# === Trading Configuration ===
# INITIAL_CAPITAL=100000
# MAX_POSITION_SIZE=0.25
# MAX_DAILY_LOSS=0.05

# === CORS Settings (Auto-configured for Railway domain) ===
# CORS_ORIGINS=https://your-app.up.railway.app
