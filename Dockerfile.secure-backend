# Secure Backend Dockerfile
# AI Stock Trading Platform - Security Enhanced Version

FROM python:3.11-slim

# Set security environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Install system dependencies with security updates
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libc6-dev \
    libffi-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements-simple-secure.txt .

# Install Python dependencies with security hardening
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-simple-secure.txt && \
    rm -rf /root/.cache/pip

# Copy application code
COPY backend/security_config.py .
COPY backend/secure_backend.py .

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/data /app/cache && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app

# Security hardening
RUN chmod 644 /app/*.py && \
    chmod 755 /app/logs /app/data /app/cache

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Set secure defaults
ENV FLASK_APP=secure_backend.py \
    FLASK_ENV=production \
    SECRET_KEY=change-this-in-production \
    JWT_SECRET_KEY=change-this-jwt-secret-in-production

# Security scan would be run here in production
# RUN bandit -r /app -x /app/logs,/app/data,/app/cache

# Start the application
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--timeout", "30", "--access-logfile", "-", "--error-logfile", "-", "--log-level", "info", "secure_backend:app"]
